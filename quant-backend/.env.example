# Upstox — long-lived (1yr) read-only Analytics token from
# https://developer.upstox.com dashboard. This app only runs off this
# token; there's no login flow.
UPSTOX_ACCESS_TOKEN=

# Trendlyne MCP Pro — from trendlyne.com/subscription/mcp/plans dashboard
TRENDLYNE_MCP_URL=
TRENDLYNE_API_KEY=

# Turso — hosted SQLite-compatible database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

WATCHLIST_LIMIT=50
FUNDAMENTALS_MAX_AGE_DAYS=10
